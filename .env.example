# Copy to `.env` for local development. Values here match docker-compose.dev.yml.
# Naming convention should ultimately track inclusaai-infra's CONTRACT.md (see README "Missing docs").

# ---- Service identity ----
SERVICE_NAME=asr-service
LOG_LEVEL=INFO
ENV=dev

# ---- HTTP / gRPC bind ----
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
GRPC_PORT=50051

# ---- Kafka (redpanda in dev; speaks the Kafka protocol) ----
# Leave empty (or point at an unreachable host) to run the service OFFLINE: no
# broker connection, no consume/publish loop — just the HTTP surface + stub
# inference. Mirrors an unset MODEL_NAME. Set a real broker to enable the event loop.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=asr-service
# Auto-created topics in dev; provisioned by inclusaai-infra in staging/prod.
#
# Managed-broker SASL/TLS (Upstash / Redpanda Cloud / Confluent / Aiven). The
# KAFKA_* settings are read by inclusaai_kafka_clients::security_kwargs straight
# from the process environment — NOT from this .env file (pydantic-settings
# doesn't export them) — so export them in your shell or deployment config.
# Credentials without KAFKA_SECURITY_PROTOCOL imply SASL_SSL.
#
# Aiven (verified working 2026-10-14):
#   KAFKA_BOOTSTRAP_SERVERS=kafka-<id>-<svc>-<n>.l.aivencloud.com:<port>
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=PLAIN          # Aiven's default; SCRAM-SHA-256 also works
#   KAFKA_USERNAME=<aiven username>     # from Aiven -> service -> Connection info
#   KAFKA_CA_CERT=<inline PEM body>     # REQUIRED - Aiven's CA is not public
# KAFKA_SECURITY_PROTOCOL=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_CA_CERT=/path/to/ca.pem   (or the inline PEM body itself)
#
# NOTE: with SASL_SSL, aiokafka raises "ssl_context is mandatory" if
# KAFKA_CA_CERT is empty/unset. The producer swallows that into offline mode,
# so with REQUIRE_KAFKA=true it surfaces as /readyz 503 rather than silence.
#
# Honesty gates (ai_core): REQUIRE_KAFKA=true flips /readyz to 503 when the
# broker is unreachable so an offline-stub instance can't masquerade as serving.
# REQUIRE_MODEL=true does the same when a configured MODEL_NAME fails to load.
# REQUIRE_KAFKA=
# REQUIRE_MODEL=

# ---- MLflow model registry (local in dev; shared infra-hosted instance in staging/prod, per ADR-0005) ----
MLFLOW_TRACKING_URI=http://localhost:5000
# Model to pull: registered name + stage or explicit version. Never a raw checkpoint path.
MODEL_NAME=asr-whisper
MODEL_STAGE=Production
# DEV-ONLY (asr-service): set to a faster-whisper size (e.g. base, small) to load the model
# IN-PROCESS and bypass MLflow entirely — real transcripts on a box with no registry.
# Takes precedence over MODEL_NAME; first run downloads ~145 MB (base). Leave unset in staging/prod.
# ASR_WHISPER_SIZE=base

# ---- Object storage (MinIO in dev; S3-compatible in prod) — MLflow artifact backend ----
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ---- OpenTelemetry ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=asr-service

# ---- Usage aggregation (ai.usage.aggregate, per ADR-0009) ----
USAGE_AGGREGATE_INTERVAL_SECONDS=60

# ---- CV pipeline (sign-recognition / vision-quality only) ----
# Video frame sampling rate — starting point per ADR-0007, tune with real accuracy data.
VIDEO_SAMPLE_FPS=15
